# .env.example
# Copy this file to .env and keep real secrets out of Git.

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Upstox SDK per-request timeouts
# ---------------------------------------------------------------------------
# Per-request read timeout applied to every HistoryV3 SDK call. Prevents a
# single slow upstream response from stalling the whole backup run — a
# stalled instrument fails after this many seconds and the loop moves on.
UPSTOX_REQUEST_TIMEOUT_SECONDS=60
UPSTOX_CONNECT_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/backup.log

# ---------------------------------------------------------------------------
# Candle cache
# ---------------------------------------------------------------------------
DATA_DIR=data
HISTORY_LOOKBACK_DAYS=10
HISTORY_MAX_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Historical completeness
# ---------------------------------------------------------------------------
HISTORY_STRICT_COMPLETENESS=true
HISTORY_VERIFY_OVERLAP_DAYS=1

# ---------------------------------------------------------------------------
# Market window
# ---------------------------------------------------------------------------
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:40

# ---------------------------------------------------------------------------
# Intraday test mode
# ---------------------------------------------------------------------------
INTRADAY_TEST_MODE=false

# ---------------------------------------------------------------------------
# Instrument archive (free, no auth)
# ---------------------------------------------------------------------------
INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
INSTRUMENTS_CACHE_DIR=data/_cache

# ---------------------------------------------------------------------------
# All-instruments snapshot (written after every discovery run)
# ---------------------------------------------------------------------------
# Path to the snapshot file that maps instrument_key -> instrument metadata
# (with expiry already converted to a readable "YYYY-MM-DD" date).
#
# Default (unset): <DATA_DIR>/all_instruments.json
#   -> with the default DATA_DIR=data, this is "data/all_instruments.json".
#
# Because it lives inside data/, the file is automatically included in
# the MEGA backup zip (as "all_instruments.json" at the archive root).
#
# Uncomment to override:
# ALL_INSTRUMENTS_FILE=data/all_instruments.json

# ---------------------------------------------------------------------------
# All-index-instruments snapshot (written after every discovery run)
# ---------------------------------------------------------------------------
# Path to the snapshot file that lists every index row from the Upstox
# archive — NIFTY 50, SENSEX, BANKNIFTY, FINNIFTY, MIDCPNIFTY, all BSE
# indices, and so on. Each entry carries instrument_key, trading_symbol,
# name, segment, exchange, and the rest of the upstream metadata.
#
# Output shape:
#   { "total": N, "indexs": [ { "instrument_key": "...", ... }, ... ] }
#
# Default (unset): <DATA_DIR>/index_instruments.json
#   -> with the default DATA_DIR=data, this is "data/index_instruments.json".
#
# Because it lives inside data/, the file is automatically included in
# the MEGA backup zip (as "index_instruments.json" at the archive root).
#
# Uncomment to override:
# INDEX_INSTRUMENTS_FILE=data/index_instruments.json

# ---------------------------------------------------------------------------
# Underlyings to back up (nearest-expiry option chains only)
# ---------------------------------------------------------------------------
NIFTY_UNDERLYING=NIFTY
SENSEX_UNDERLYING=SENSEX
BANKNIFTY_UNDERLYING=BANKNIFTY
MIDCPNIFTY_UNDERLYING=MIDCPNIFTY

# Main index instrument keys.
# These rows are fetched intraday to compute the dynamic strike window,
# and are also backed up as their own candle + EMA series under
#   data/index/nifty/{candles.json, ema_crosses.json}
#   data/index/sensex/{candles.json, ema_crosses.json}
#   data/index/banknifty/{candles.json, ema_crosses.json}
#   data/index/midcpnifty/{candles.json, ema_crosses.json}
NIFTY_INDEX_INSTRUMENT_KEY=NSE_INDEX|Nifty 50
SENSEX_INDEX_INSTRUMENT_KEY=BSE_INDEX|SENSEX
BANKNIFTY_INDEX_INSTRUMENT_KEY=NSE_INDEX|Nifty Bank
MIDCPNIFTY_INDEX_INSTRUMENT_KEY=NSE_INDEX|NIFTY MID SELECT

# ---------------------------------------------------------------------------
# Dynamic strike ranges (derived from each index's intraday candles)
# ---------------------------------------------------------------------------
# The strike window is computed at runtime from a reference close picked
# according to the current IST time (see STRIKE_RANGE_MODE_CUTOFF_TIME):
#
#   min = floor((reference_close - range_points) / rounding) * rounding
#   max = ceil ((reference_close + range_points) / rounding) * rounding
#
# Defaults:
#   NIFTY      -> ±500   rounded to 50
#   SENSEX     -> ±1000  rounded to 100
#   BANKNIFTY  -> ±1500  rounded to 100
#   MIDCPNIFTY -> ±500   rounded to 25
NIFTY_STRIKE_RANGE_POINTS=500
SENSEX_STRIKE_RANGE_POINTS=1000
BANKNIFTY_STRIKE_RANGE_POINTS=1500
MIDCPNIFTY_STRIKE_RANGE_POINTS=500
NIFTY_STRIKE_ROUNDING=50
SENSEX_STRIKE_ROUNDING=100
BANKNIFTY_STRIKE_ROUNDING=100
MIDCPNIFTY_STRIKE_ROUNDING=25

# ---------------------------------------------------------------------------
# Strike-range mode cutover time (HH:MM, IST)
# ---------------------------------------------------------------------------
# Determines which intraday candle supplies the reference close:
#
#   09:15 <= now < 10:00  -> FIRST candle of today
#   10:00 <= now < 23:59  -> LAST  candle of today
#   otherwise             -> fall back to FIRST candle (with a warning)
#
# Each run logs the window + mode + candle_ts + close it used, e.g.:
#   [STRIKE-RANGE] NSE_INDEX|Nifty 50 | window=10:00-23:59 IST |
#   mode=LAST candle | candle_ts=2026-10-23T14:30:00+05:30 |
#   close=24832.10 | ±500 (step 50) -> range=[24300, 25350]
STRIKE_RANGE_MODE_CUTOFF_TIME=10:00

# ---------------------------------------------------------------------------
# Static strike-range fallbacks (used ONLY when dynamic computation fails)
# ---------------------------------------------------------------------------
# If the intraday fetch for an index fails (network / upstream error)
# the backup falls back to the static range below so the run still
# produces option candles. Set MIN==MAX to disable the fallback for an
# underlying and skip it entirely on failure.
NIFTY_STRIKE_MIN=21000
NIFTY_STRIKE_MAX=26000

SENSEX_STRIKE_MIN=71000
SENSEX_STRIKE_MAX=73000

BANKNIFTY_STRIKE_MIN=45000
BANKNIFTY_STRIKE_MAX=65000

MIDCPNIFTY_STRIKE_MIN=10000
MIDCPNIFTY_STRIKE_MAX=15000

# ---------------------------------------------------------------------------
# EMA / crosses
# ---------------------------------------------------------------------------
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21

# ---------------------------------------------------------------------------
# EMA cross validation (mirrors the Pine Script indicator)
# ---------------------------------------------------------------------------
EMA_ENABLE_VALIDATION=true
EMA_MIN_VALIDATION_SCORE=3

EMA_USE_TREND_FILTER=true
EMA_USE_SEPARATION_FILTER=true
EMA_USE_SLOPE_FILTER=true
EMA_USE_VOLUME_FILTER=true
EMA_USE_BODY_FILTER=true
EMA_USE_DISTANCE_FILTER=true

EMA_TREND_FAST_PERIOD=50
EMA_TREND_SLOW_PERIOD=100
EMA_ATR_PERIOD=14
EMA_SEP_ATR_MIN=0.15
EMA_SLOPE_LOOKBACK=3
EMA_VOLUME_LOOKBACK=20
EMA_VOLUME_MULT=1.0
EMA_DISTANCE_ATR_MAX=1.5

# ---------------------------------------------------------------------------
# MEGA cloud backup
# ---------------------------------------------------------------------------
# ⚠️  SECRETS — add in prod env:
#     MEGA_EMAIL    -> GitHub Actions secret "MEGA_EMAIL"
#     MEGA_PASSWORD -> GitHub Actions secret "MEGA_PASSWORD"
MEGA_ENABLED=true
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_BACKUP_FOLDER=novag7_candles_backup

# ---------------------------------------------------------------------------
# Telegram notifications (optional)
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=""
TELEGRAM_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# MongoDB (backup metadata / blob only)
# ---------------------------------------------------------------------------
MONGO_ENABLED=false
MONGO_URL=
MONGO_DB_NAME=UPSTOX_APP_V2
MONGO_METADATA_COLLECTION=app_tokens
MONGO_METADATA_DOC_ID=backup_candles
MONGO_BLOB_COLLECTION=backup_collection
MONGO_BLOB_DOC_ID=backup_historical_candles
MONGO_MAX_BLOB_MB=15
MONGO_TIMEOUT_MS=10000

# NOTE: The Upstox instrument archive and the HistoryV3 candle endpoints
# are public — no access token is required anywhere in this project.

# ---------------------------------------------------------------------------
# Support / Resistance levels (pivot detection)
# ---------------------------------------------------------------------------
# Mirrors the Pine Script indicator "Support and Resistance Levels with
# Breaks" (LuxAlgo, CC BY-NC-SA 4.0). A pivot is only confirmed
# right_bars bars after the swing bar itself; sr_levels.json records
# both timestamps so the confirmation moment is explicit.
#
# Written per instrument to:
#   data/index/<underlying>/sr_levels.json
#   data/<underlying>/<strike>_<type>/sr_levels.json
SR_ENABLED=true
SR_LEFT_BARS=15
SR_RIGHT_BARS=1