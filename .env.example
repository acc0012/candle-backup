# Copy this file to .env and keep real secrets out of Git.

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/backup.log

# ---------------------------------------------------------------------------
# Candle cache
# ---------------------------------------------------------------------------
DATA_DIR=data
HISTORY_LOOKBACK_DAYS=10
HISTORY_MAX_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Historical completeness
# ---------------------------------------------------------------------------
HISTORY_STRICT_COMPLETENESS=true
HISTORY_VERIFY_OVERLAP_DAYS=1

# ---------------------------------------------------------------------------
# Market window
# ---------------------------------------------------------------------------
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:40

# ---------------------------------------------------------------------------
# Intraday test mode
# ---------------------------------------------------------------------------
INTRADAY_TEST_MODE=false

# ---------------------------------------------------------------------------
# Instrument archive (free, no auth)
# ---------------------------------------------------------------------------
INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/complete.json.gz
INSTRUMENTS_CACHE_DIR=data/_cache

# ---------------------------------------------------------------------------
# Underlyings to back up (nearest-expiry option chains only)
# ---------------------------------------------------------------------------
NIFTY_UNDERLYING=NIFTY
SENSEX_UNDERLYING=SENSEX

# Nifty strikes 21000..26000
NIFTY_STRIKE_MIN=21000
NIFTY_STRIKE_MAX=26000

# Sensex strikes — set your desired range here
SENSEX_STRIKE_MIN=71000
SENSEX_STRIKE_MAX=71000

# ---------------------------------------------------------------------------
# EMA / crosses
# ---------------------------------------------------------------------------
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21

# ---------------------------------------------------------------------------
# MEGA cloud backup
# ---------------------------------------------------------------------------
# ⚠️  SECRETS — add in prod env:
#     MEGA_EMAIL    -> GitHub Actions secret "MEGA_EMAIL"
#     MEGA_PASSWORD -> GitHub Actions secret "MEGA_PASSWORD"
MEGA_ENABLED=true
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_BACKUP_FOLDER=novag7_candles_backup

# ---------------------------------------------------------------------------
# Telegram notifications (optional)
# ---------------------------------------------------------------------------
# ⚠️  SECRETS — add in prod env (only if enabled):
#     TELEGRAM_BOT_TOKEN -> GitHub Actions secret "TELEGRAM_BOT_TOKEN"
#     TELEGRAM_CHAT_ID   -> GitHub Actions secret "TELEGRAM_CHAT_ID"
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=""
TELEGRAM_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# MongoDB (backup metadata / blob only)
# ---------------------------------------------------------------------------
# ⚠️  SECRET — add in prod env:
#     MONGO_URL -> GitHub Actions secret "MONGO_URL"
MONGO_ENABLED=false
MONGO_URL=
MONGO_DB_NAME=UPSTOX_APP_V2
MONGO_METADATA_COLLECTION=app_tokens
MONGO_METADATA_DOC_ID=backup_candles
MONGO_BLOB_COLLECTION=backup_collection
MONGO_BLOB_DOC_ID=backup_historical_candles
MONGO_MAX_BLOB_MB=15
MONGO_TIMEOUT_MS=10000

# NOTE: The Upstox instrument archive and the HistoryV3 candle endpoints
# are public — no access token is required anywhere in this project.