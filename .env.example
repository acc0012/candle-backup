# Copy this file to .env and keep real secrets out of Git.

# ---------------------------------------------------------------------------
# Upstream subscriptions endpoint
# ---------------------------------------------------------------------------
# The URL that returns {"active": [...]} — one row per instrument to back up.
SUBSCRIPTIONS_API_URL=https://{your-domain}/api/subscriptions

# HTTP timeout for the subscriptions fetch, in seconds.
REQUEST_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/backup.log

# ---------------------------------------------------------------------------
# Candle cache
# ---------------------------------------------------------------------------
DATA_DIR=data
HISTORY_LOOKBACK_DAYS=10
HISTORY_MAX_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Market window (used by the intraday fetch — outside this window the
# intraday step is skipped automatically).
# ---------------------------------------------------------------------------
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:40

# ---------------------------------------------------------------------------
# Intraday test mode
# ---------------------------------------------------------------------------
# When true, the intraday candle fetch runs even outside the market
# window. Useful for:
#   * CI runs that happen before the market opens (e.g. 05:00 IST)
#   * manual verification on a weekend or after hours
#
# When false (default), the intraday step is skipped outside the window
# and the run continues normally.
#
# NOTE: the flag only controls whether the fetch is attempted. The
# upstream endpoint will still return an empty list if there is no data
# for the current day.
INTRADAY_TEST_MODE=false

# ---------------------------------------------------------------------------
# MEGA cloud backup
# ---------------------------------------------------------------------------
# Master switch. When false, the tool fetches candles but does not upload.
MEGA_ENABLED=true

# MEGA account credentials. In CI these are provided as GitHub Secrets.
MEGA_EMAIL=
MEGA_PASSWORD=

# Name of the folder that holds the backup inside the MEGA root.
# The folder is deleted and recreated on every upload. A single zip
# archive is stored inside it.
MEGA_BACKUP_FOLDER=novag7_candles_backup

# ---------------------------------------------------------------------------
# Telegram notifications (optional, best-effort)
# ---------------------------------------------------------------------------
# Sends three messages per run to the configured chat:
#   - "Candle Backup Started"
#   - "Candle Backup Completed"  (or "Candle Backup Failed")
# No Telegram package is required — the Bot HTTP API is called directly.
#
#   true  -> notifications enabled
#   false -> notifications disabled (default)
TELEGRAM_ENABLED=false

# Bot token from @BotFather (e.g. 123456789:AA...).
TELEGRAM_BOT_TOKEN=

# Target chat id. Accepts numeric user ids, negative group ids, or a
# channel handle like "@mychannel". Quotes are stripped.
TELEGRAM_CHAT_ID=""

# Per-request timeout for the Telegram API, in seconds.
TELEGRAM_TIMEOUT_SECONDS=10