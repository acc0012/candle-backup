# Copy this file to .env and keep real secrets out of Git.

# ---------------------------------------------------------------------------
# Upstream subscriptions endpoint
# ---------------------------------------------------------------------------
# The URL that returns {"active": [...]} — one row per instrument to back up.
SUBSCRIPTIONS_API_URL=https://{your-domain}/api/subscriptions

# HTTP timeout for the subscriptions fetch, in seconds.
REQUEST_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/backup.log

# ---------------------------------------------------------------------------
# Candle cache
# ---------------------------------------------------------------------------
DATA_DIR=data
HISTORY_LOOKBACK_DAYS=10
HISTORY_MAX_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Historical completeness
# ---------------------------------------------------------------------------
# When true (default), every run re-fetches the entire lookback window so
# the backup uploaded to MEGA/Mongo always contains every market day, with
# no internal gaps. This is the mode a backup job should use: the main
# application can bootstrap from it without doing any additional fetches.
#
# When false, the historical job uses the incremental skip: if the local
# file already contains data through the previous trading day, it is
# skipped. Faster, but can hide gaps left by earlier failed runs.
HISTORY_STRICT_COMPLETENESS=true

# Extra days *before* the lookback window that each fetch re-verifies.
# Upstox occasionally back-fills the most recent trading day after
# midnight; this overlap catches that. Set to 0 to disable overlap.
HISTORY_VERIFY_OVERLAP_DAYS=1

# ---------------------------------------------------------------------------
# Market window (used by the intraday fetch — outside this window the
# intraday step is skipped automatically).
# ---------------------------------------------------------------------------
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:40

# ---------------------------------------------------------------------------
# Intraday test mode
# ---------------------------------------------------------------------------
# When true, the intraday candle fetch runs even outside the market
# window. Useful for CI runs that happen before the market opens, and for
# manual verification.
#
# IMPORTANT: this variable name is case-sensitive. Use INTRADAY_TEST_MODE,
# not intraday_test_mode.
INTRADAY_TEST_MODE=true
HISTORY_STRICT_COMPLETENESS=true
HISTORY_VERIFY_OVERLAP_DAYS=1
# ---------------------------------------------------------------------------
# MEGA cloud backup
# ---------------------------------------------------------------------------
MEGA_ENABLED=true
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_BACKUP_FOLDER=novag7_candles_backup

# ---------------------------------------------------------------------------
# Telegram notifications (optional, best-effort)
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=""
TELEGRAM_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# MongoDB (optional)
# ---------------------------------------------------------------------------
# When enabled, every run upserts two fixed documents:
#
#   * MONGO_METADATA_COLLECTION / MONGO_METADATA_DOC_ID
#       The full run metadata + MEGA public file link.
#
#   * MONGO_BLOB_COLLECTION / MONGO_BLOB_DOC_ID
#       The archive bytes (only when the archive is smaller than
#       MONGO_MAX_BLOB_MB).
#
# Both documents are updated in place — no new documents accumulate.
MONGO_ENABLED=false

# Full MongoDB connection string.
MONGO_URL=

# Database name. Defaults to UPSTOX_APP_V2.
MONGO_DB_NAME=UPSTOX_APP_V2

# Metadata document.
MONGO_METADATA_COLLECTION=app_tokens
MONGO_METADATA_DOC_ID=backup_candles

# Blob document.
MONGO_BLOB_COLLECTION=backup_collection
MONGO_BLOB_DOC_ID=backup_historical_candles

# Skip the blob save if the archive exceeds this size in MB.
#
# NOTE: MongoDB's hard BSON document limit is 16 MB. Leave this at 15 or
# below to stay clear of the limit.
MONGO_MAX_BLOB_MB=15

# Server-selection / connect timeout, milliseconds.
MONGO_TIMEOUT_MS=10000